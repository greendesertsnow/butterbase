# --- S3 Configuration ---
S3_ACCESS_KEY_ID="your_s3_access_key_id"
S3_SECRET_ACCESS_KEY="your_s3_secret_access_key"
S3_REGION="your_s3_region"
S3_BUCKET_NAME="your_s3_bucket_name"
S3_ENDPOINT_URL="your_s3_endpoint_url" # Optional: for MinIO or other S3-compatible services
S3_PUBLIC_URL_PREFIX="your_s3_public_url_prefix" # Optional: if files are publicly accessible via a CDN or different domain

# --- Email Configuration (Nodemailer SMTP) ---
SMTP_HOST="your_smtp_host"
SMTP_PORT="587" # or 465 for SSL
SMTP_USER="your_smtp_user"
SMTP_PASS="your_smtp_password"
SMTP_SECURE="false" # true for port 465, false for 587 (STARTTLS)
EMAIL_FROM_ADDRESS="noreply@example.com"
APP_NAME="Your Awesome App"
APP_URL="http://localhost:3000" # Base URL for frontend links

# --- Admin Configuration ---
# Comma-separated list of email addresses for users considered admins
ADMIN_EMAILS="admin@example.com,super_user@example.com"
